<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Portfolio Alpha - Tech City</title>
    <meta name="description" content="Portfolio personnel de Alpha Kitara, étudiant en L3 IAGE.">

    <link rel="stylesheet" href="{{ site.baseurl }}/css/style.css">
</head>

<body>

<!-- HEADER -->
<header class="header">
    <a href="#accueil" class="logo">ALPHA<span>.</span></a>

    <nav class="navigation">
        <a href="#accueil">Accueil</a>
        <a href="#apropos">À propos</a>
        <a href="#competences">Compétences</a>
        <a href="#projets">Projets</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<!-- ACCUEIL -->
<section class="hero" id="accueil">

    <div class="hero-content">
        <p class="eyebrow">BIENVENUE SUR MON PORTFOLIO</p>

        <h1>ALPHA <span>KITARA</span></h1>

        <h2>Étudiant en L3 IAGE</h2>

        <p class="description">
            Informatique Appliquée à la Gestion d'Entreprise.
            Passionné par le développement web, les technologies
            numériques et les systèmes informatiques.
        </p>

        <div class="hero-buttons">
            <a href="#apropos" class="btn primary">Découvrir</a>
            <a href="#contact" class="btn secondary">Me contacter</a>
        </div>
    </div>

    <!-- PHOTO PERSONNELLE ALPHA -->
<div class="profile-photo">
    <img src="{{ site.baseurl }}/images/alpha.jpg" alt="Photo de profil de Alpha Kitara">
</div>

    <div class="hero-visual">
        <div class="code-card">

            <div class="code-top">
                <span></span>
                <span></span>
                <span></span>
                <small>Alpha.dev</small>
            </div>

            <div class="code-content">
                <p class="code-blue">Étudiant en L3 IAGE</p>
                <p class="indent">Développement web</p>
                <p class="code-green">Innovation numérique</p>
                <p class="indent">Gestion informatique</p>
            </div>

        </div>

        <div class="visual-glow"></div>
    </div>

</section>

<!-- A PROPOS -->
<section class="section" id="apropos">

    <h2>À propos <span>de moi</span></h2>

    <p class="section-text">
        Je suis Alpha Kitara, étudiant en troisième année de Licence
        en Informatique Appliquée à la Gestion d'Entreprise.

        Je m'intéresse au développement web, aux réseaux informatiques,
        aux bases de données et aux systèmes d'information.

        Mon objectif est de développer mes compétences et de concevoir
        des solutions informatiques capables de répondre aux besoins
        des entreprises.
    </p>

</section>

<!-- COMPETENCES -->
<section class="section" id="competences">

    <h2>Mes <span>compétences</span></h2>

    <div class="cards">

        <div class="card">
            <div class="card-icon">01</div>
            <h3>HTML et CSS</h3>
            <p>
                Création de pages web et mise en forme
                des interfaces numériques.
            </p>
        </div>

        <div class="card">
            <div class="card-icon">02</div>
            <h3>Réseaux informatiques</h3>
            <p>
                Connaissances des réseaux, des protocoles
                et des systèmes informatiques.
            </p>
        </div>

        <div class="card">
            <div class="card-icon">03</div>
            <h3>Bases de données</h3>
            <p>
                Notions de conception, d'organisation
                et de gestion des données.
            </p>
        </div>

    </div>

</section>

<!-- PROJETS -->
<section class="section" id="projets">

    <h2>Mes <span>projets</span></h2>

    <p class="section-text">
        Quelques domaines de projets que je développe
        progressivement dans le cadre de ma formation.
    </p>

    <div class="cards">

        <div class="card project">
            <div class="project-number">01</div>
            <h3>Portfolio personnel</h3>
            <p>
                Création de mon site personnel avec HTML,
                CSS et Cecil.
            </p>
        </div>

        <div class="card project">
            <div class="project-number">02</div>
            <h3>Gestion commerciale</h3>
            <p>
                Conception d'une application de gestion
                commerciale et de ses données.
            </p>
        </div>

        <div class="card project">
            <div class="project-number">03</div>
            <h3>Réseaux informatiques</h3>
            <p>
                Travaux pratiques sur les réseaux
                et les systèmes informatiques.
            </p>
        </div>

    </div>

</section>

<!-- CONTACT -->
<section class="contact-section" id="contact">

    <h2>Travaillons <span>ensemble</span></h2>

    <p>
        Merci de visiter mon portfolio personnel.
        N'hésitez pas à me contacter pour échanger.
    </p>

    <a href="mailto:" class="btn primary">Me contacter</a>

</section>

<!-- FOOTER -->
<footer>
    <p>© 2026 Alpha Kitara - Portfolio personnel</p>
    <p>Créé avec Cecil</p>
</footer>

